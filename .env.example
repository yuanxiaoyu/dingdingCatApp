# 丁丁猫应用环境变量配置示例
# DingDingCat App Environment Variables Example

# Mock功能控制
# Mock Feature Control
MOCK_ENABLED=1          # 1: 开启Mock模式, 0: 关闭Mock模式 (Enable/Disable Mock Mode)
MOCK_USER_STATE=1       # 0: 未登录状态, 1: 登录状态 (0: Not Logged In, 1: Logged In)

# 使用说明 Usage Instructions:
# 1. 复制此文件为 .env
# 2. 根据需要修改配置值
# 3. 重启应用使配置生效

# Copy this file to .env and modify values as needed
# Restart the app for changes to take effect

# 配置组合示例 Configuration Examples:
# 
# 测试未登录流程 (Test Not Logged In Flow):
# MOCK_ENABLED=1
# MOCK_USER_STATE=0
#
# 测试登录流程 (Test Logged In Flow):
# MOCK_ENABLED=1
# MOCK_USER_STATE=1
#
# 关闭Mock使用真实API (Disable Mock, Use Real API):
# MOCK_ENABLED=0
# MOCK_USER_STATE=1  # 此时此值无效 (This value is ignored when mock is disabled)